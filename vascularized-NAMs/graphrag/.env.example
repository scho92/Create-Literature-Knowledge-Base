# Copy this file to .env (same directory). .env is gitignored and loaded
# automatically by load_graph.py / query_rag.py — never commit your real .env.
#
# This project runs entirely on local, free tools (Docker Neo4j + Ollama).
# No OpenAI/Anthropic API key is needed or used anywhere in this codebase.
# All values below are optional — if omitted, the defaults shown are used.

# Only needed if you changed the docker-compose.yml Neo4j credentials/port:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-own-neo4j-password

# Only needed if Ollama runs somewhere other than the default local port,
# or you prefer different local models:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.1
