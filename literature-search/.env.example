# Copy this file to .env (same directory). .env is gitignored and loaded
# automatically by search_wos.py — never commit your real .env.
#
# Bring your own Web of Science Expanded API key (api.clarivate.com),
# typically available through an institutional/library subscription.
# This repo does not include or store anyone's key.

WOS_API_KEY=your-own-wos-expanded-api-key
